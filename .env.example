# =============================================================================
# my-agent configuration
#
# Copy to `.env` (make env) and adjust. Every value is also settable as a
# plain environment variable; `.env` is only a convenience for compose.
# =============================================================================

# --- workspace ---------------------------------------------------------------
# Sandbox root for every file tool. Paths outside of it are rejected.
# Inside the dev container the repository is mounted at /workspace.
AGENT_WORKSPACE=/workspace

# --- agent loop --------------------------------------------------------------
AGENT_MAX_ITERATIONS=25
AGENT_MAX_TOOL_OUTPUT_BYTES=32768
AGENT_TOOL_TIMEOUT_SECS=60
AGENT_MAX_HISTORY_BYTES=262144
AGENT_PARALLEL_READ_TOOLS=true
# Stream responses token by token (SSE). Set to false if a server rejects
# `stream: true` or `stream_options`, or to restore whole-request retries.
AGENT_STREAM=true
# Largest file `read_file` will load.
AGENT_MAX_FILE_BYTES=2097152

# --- web fetch ----------------------------------------------------------------
# Give the model a web_fetch tool. OFF by default: a URL is an outbound message
# and can carry anything the model puts in it. Even when enabled, private and
# internal addresses are always refused, and the default approval policy
# confirms every call (the prompt shows the full URL).
# AGENT_WEB_FETCH=true
# Optional domain allowlist (suffix match). Unset = any public host.
# AGENT_WEB_FETCH_ALLOW=docs.rs,doc.rust-lang.org
# AGENT_WEB_FETCH_MAX_BYTES=1048576
# AGENT_WEB_FETCH_TIMEOUT_SECS=30
# Intranet escape hatch - lifts the private-address blocking. Leave off.
# AGENT_WEB_FETCH_ALLOW_PRIVATE=false

# --- shell command execution --------------------------------------------------
# Give the model a run_command tool. OFF by default, and for a stronger reason
# than web_fetch: what a command does cannot be read off its arguments, so every
# call is confirmed and the sandbox - not the wording of the command - is what
# contains it.
# AGENT_SHELL=true
#
# Confinement the agent will not run without. Startup FAILS rather than falling
# back to something weaker, because a sandbox setting that silently degrades is
# worse than none at all.
#   confined - whatever this platform provides (Linux 6.7+: Landlock). Default.
#   isolated - only the tier where nothing but the proxy is reachable. Not
#              implemented on any platform yet, so this always fails today.
#   none     - no sandbox. Commands run with your full user privileges; only
#              reasonable inside a container you already treat as disposable.
# AGENT_SHELL_SANDBOX=confined
#
# Domains commands may reach, through an in-process proxy (suffix match).
# Unset = NO network at all: every outbound connection is refused, so package
# installs and downloads fail. That is the default on purpose - a command that
# can reach anything can also send the workspace to it.
# AGENT_SHELL_NETWORK_ALLOW=crates.io,static.crates.io,index.crates.io
#
# Writable roots outside the workspace. Needed when a build cache lives
# elsewhere (CARGO_TARGET_DIR, ~/.cargo/registry). Everything else outside the
# workspace stays read-only, enforced by the kernel.
# AGENT_SHELL_WRITABLE=/workspace/target

# --- history compaction --------------------------------------------------------
# When the history outgrows AGENT_MAX_HISTORY_BYTES, fold the oldest turns into
# an LLM-written summary instead of deleting them. ON by default: the messages
# deleted first are the oldest, and the oldest message is the one where you said
# what you wanted.
#
# The cost is one extra request, and only at the moment content would otherwise
# be lost. It is labelled TaskKind::Summarize, so a router can send it to a
# cheaper model. If it fails for any reason the agent falls back to deleting, so
# turning this off changes what you pay, never whether the turn completes.
# AGENT_COMPACT=false
#
# The most messages kept word-for-word after a compaction. Everything older
# becomes the summary.
# AGENT_COMPACT_KEEP_RECENT=12
#
# ...and the most bytes those messages may take up, which is the cap that
# usually decides. A message count says nothing about how big the messages are:
# twelve one-line answers are 2 KB, twelve tool results are 384 KB - more than
# AGENT_MAX_HISTORY_BYTES all by themselves, so the tail that was meant to be
# protected is what forces the fresh summary back out of the budget. Lower this
# to keep less recent conversation word-for-word (and more of it as summary).
# AGENT_COMPACT_KEEP_RECENT_BYTES=65536

# --- session log ---------------------------------------------------------------
# The conversation is appended to a file as it happens, one JSON object per
# line, BEFORE compaction or trimming can shorten it. That ordering is the
# point: both of those are irreversible, so the log is the only place the
# original turns still exist afterwards.
#
# WARNING: this file holds the conversation VERBATIM - every prompt, every
# answer, and the full contents of every file the model read. It is written
# inside the workspace by default, which also means the model's own read_file
# can reach it. Point AGENT_SESSION_DIR at an absolute path outside the
# workspace if that matters to you, or turn the log off.
#
# AGENT_SESSION_LOG=false
#
# Where the files go. A relative path resolves against AGENT_WORKSPACE (not the
# current directory), and .agent/ is already in .gitignore.
# AGENT_SESSION_DIR=.agent/sessions
#
# How long the records are kept. Applied at startup: a session goes when it is
# past EITHER limit. Without these the directory only ever grows, because the
# log only ever appends.
#
# 0 lifts a limit - it never means "delete everything now". Setting both to 0
# keeps every session forever, which is also what makes the retention entry in
# `agent doctor` worth reading before a long run.
#
# The session `--resume` names is never deleted, however old it is.
# AGENT_SESSION_KEEP=50
# AGENT_SESSION_MAX_AGE_DAYS=30

# --- system prompt injection --------------------------------------------------
# Replace the built-in system prompt with a file of your own. The file is read
# once at startup by you (the operator), so it may live outside the workspace.
# A missing or empty file aborts startup instead of silently falling back.
# AGENT_SYSTEM_PROMPT_FILE=/path/to/prompt.md
# Append extra instructions to the end of the prompt (after the project
# instruction file). Works together with the replacement above.
# AGENT_APPEND_SYSTEM_PROMPT=Reply in Japanese.

# Tool approval policy: auto | read-only | ask
#   auto       - run everything without asking (use only inside the container)
#   read-only  - read tools run freely, mutating tools need confirmation
#   ask        - confirm every tool call
AGENT_APPROVAL=read-only

# --- generation --------------------------------------------------------------
AGENT_TEMPERATURE=0.2
AGENT_MAX_TOKENS=4096
AGENT_REQUEST_TIMEOUT_SECS=180
AGENT_MAX_RETRIES=3

# =============================================================================
# LLM connection - single provider (default)
# =============================================================================
# Kind: openai | anthropic
#   `openai` speaks the OpenAI /chat/completions protocol and therefore also
#   covers Ollama, vLLM, LM Studio, llama.cpp, OpenRouter, Groq, Together, ...
AGENT_PROVIDER=openai

# ---- Example A: Ollama started by this compose file (make ollama-up) --------
AGENT_BASE_URL=http://ollama:11434/v1
AGENT_MODEL=qwen3:8b
AGENT_API_KEY=

# ---- Example B: Ollama running on the host ---------------------------------
# AGENT_BASE_URL=http://host.docker.internal:11434/v1
# AGENT_MODEL=qwen3:8b

# ---- Example C: OpenAI-compatible cloud ------------------------------------
# AGENT_BASE_URL=https://api.openai.com/v1
# AGENT_MODEL=gpt-4.1
# AGENT_API_KEY=sk-...
# Newer OpenAI models want `max_completion_tokens` instead of `max_tokens`:
# AGENT_OPENAI_MAX_TOKENS_FIELD=max_completion_tokens

# ---- Example D: Anthropic ---------------------------------------------------
# AGENT_PROVIDER=anthropic
# AGENT_BASE_URL=https://api.anthropic.com
# AGENT_MODEL=claude-sonnet-5
# AGENT_API_KEY=sk-ant-...

# =============================================================================
# LLM connection - multiple providers (enables routing)
#
# Declare aliases in AGENT_PROVIDERS, then configure each one with
# AGENT_PROVIDER_<ALIAS>_* variables. When set, this block wins over the
# single-provider block above.
# =============================================================================
# AGENT_PROVIDERS=local,cloud
# AGENT_DEFAULT_PROVIDER=local
#
# AGENT_PROVIDER_LOCAL_KIND=openai
# AGENT_PROVIDER_LOCAL_BASE_URL=http://ollama:11434/v1
# AGENT_PROVIDER_LOCAL_MODEL=qwen3:8b
#
# AGENT_PROVIDER_CLOUD_KIND=anthropic
# AGENT_PROVIDER_CLOUD_MODEL=claude-sonnet-5
# AGENT_PROVIDER_CLOUD_API_KEY=sk-ant-...
#
# Routing strategy: static | model-prefix
#   static       - always use AGENT_DEFAULT_PROVIDER
#   model-prefix - `--model cloud/claude-sonnet-5` picks the `cloud` provider
# AGENT_ROUTER=model-prefix

# --- logging -----------------------------------------------------------------
# Standard tracing filter, e.g. `info`, `agent_application=debug,warn`
RUST_LOG=warn
# Set to 1 to get backtraces on errors (useful when debugging tests).
RUST_BACKTRACE=0

# --- host-side compose knobs --------------------------------------------------
# OLLAMA_PORT=11434
