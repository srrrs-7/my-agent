# =============================================================================
# my-agent configuration
#
# Copy to `.env` (make env). These three lines are all that is required.
# Every other setting is optional and has a default - see README §8 for the
# full list. Any value can also be passed as a plain environment variable.
# =============================================================================

# openai | ollama | anthropic
AGENT_PROVIDER=anthropic
AGENT_API_KEY=sk-ant-...
AGENT_MODEL=claude-sonnet-5-5

# ---- OpenAI ------------------------------------------------------------------
# AGENT_PROVIDER=openai
# AGENT_API_KEY=sk-...
# AGENT_MODEL=<an OpenAI model ID>

# ---- Ollama (make ollama-up && make ollama-pull MODEL=qwen3:8b) --------------
# No key needed.
# AGENT_PROVIDER=ollama
# AGENT_MODEL=qwen3:8b
